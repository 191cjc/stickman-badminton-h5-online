{
  "name": "stickman-badminton-h5-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "assets:atlas": "node tools/flash-assets/bake.mjs",
    "assets:verify": "node tools/flash-assets/verify-atlas.mjs",
    "test": "vitest run",
    "build": "npm run assets:verify && npm run typecheck && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "lint": "eslint src tests vite.config.ts",
    "format": "prettier --write src tests docs README.md vite.config.ts"
  },
  "dependencies": {
    "pixi.js": "8.22.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "playwright": "1.62.0",
    "pngjs": "7.0.0",
    "prettier": "^3.7.4",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.49.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
